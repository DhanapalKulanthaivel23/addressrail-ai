{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "apps/workbench/main.tsx",
    "apps/workbench/learning-tools.tsx",
    "apps/workbench/storage.ts"
  ]
}
